<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Samsung Brasil | Celulares, TVs, Eletrodomésticos e Mais</title>
    <link href="https://fonts.googleapis.com/css2?family=Samsung+One:wght@300;400;500;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --samsung-blue: #1428a0;
            --samsung-dark: #000000;
            --samsung-gray: #f4f4f4;
            --samsung-text: #252525;
            --samsung-border: #e0e0e0;
            --samsung-hover: #0f1f7d;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', 'Samsung One', sans-serif;
        }

        body {
            background-color: #ffffff;
            color: var(--samsung-text);
            overflow-x: hidden;
        }

        /* Top Bar */
        .top-announcement {
            background-color: var(--samsung-gray);
            font-size: 12px;
            text-align: center;
            padding: 8px;
            color: #555;
            border-bottom: 1px solid var(--samsung-border);
        }

        /* Header */
        header {
            position: sticky;
            top: 0;
            background: #ffffff;
            z-index: 1000;
            border-bottom: 1px solid var(--samsung-border);
            box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        }

        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            height: 70px;
            max-width: 1440px;
            margin: 0 auto;
        }

        .logo svg {
            height: 20px;
            width: auto;
            fill: var(--samsung-dark);
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--samsung-dark);
            font-weight: 500;
            font-size: 14px;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: var(--samsung-blue);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .search-container {
            position: relative;
            background: var(--samsung-gray);
            border-radius: 20px;
            padding: 8px 15px;
            display: flex;
            align-items: center;
            width: 240px;
        }

        .search-container input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13px;
            width: 100%;
            margin-left: 8px;
        }

        .search-container i {
            color: #777;
            font-size: 14px;
        }

        .icon-btn {
            background: none;
            border: none;
            cursor: pointer;
            font-size: 18px;
            color: var(--samsung-dark);
            position: relative;
        }

        .cart-badge {
            position: absolute;
            top: -6px;
            right: -8px;
            background: var(--samsung-blue);
            color: white;
            font-size: 10px;
            padding: 2px 5px;
            border-radius: 50%;
            font-weight: bold;
        }

        /* Hero Carousel */
        .hero {
            position: relative;
            height: 550px;
            background: #000;
            color: white;
            overflow: hidden;
        }

        .hero-slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 0.8s ease-in-out;
            display: flex;
            align-items: center;
            padding: 0 80px;
            background-size: cover;
            background-position: center;
        }

        .hero-slide.active {
            opacity: 1;
        }

        .hero-content {
            max-width: 550px;
            z-index: 2;
        }

        .hero-content h1 {
            font-size: 42px;
            font-weight: 700;
            margin-bottom: 15px;
            line-height: 1.1;
        }

        .hero-content p {
            font-size: 16px;
            margin-bottom: 25px;
            color: #ddd;
        }

        .btn-primary {
            background-color: var(--samsung-blue);
            color: white;
            padding: 12px 28px;
            border-radius: 25px;
            border: none;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            transition: background 0.2s;
        }

        .btn-primary:hover {
            background-color: var(--samsung-hover);
        }

        .hero-indicators {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 10px;
            z-index: 10;
        }

        .indicator {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255,255,255,0.4);
            cursor: pointer;
            border: none;
            transition: background 0.2s;
        }

        .indicator.active {
            background: white;
            width: 25px;
            border-radius: 5px;
        }

        /* Products Showcase */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 60px 40px;
        }

        .section-title {
            font-size: 32px;
            font-weight: 700;
            text-align: center;
            margin-bottom: 30px;
        }

        .filter-tabs {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--samsung-gray);
            border: none;
            padding: 10px 22px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }

        .filter-btn.active, .filter-btn:hover {
            background: var(--samsung-dark);
            color: white;
        }

        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
        }

        .product-card {
            background: white;
            border: 1px solid var(--samsung-border);
            border-radius: 16px;
            padding: 25px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .product-img {
            width: 100%;
            height: 200px;
            object-fit: contain;
            margin-bottom: 20px;
        }

        .product-title {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .product-desc {
            font-size: 13px;
            color: #666;
            margin-bottom: 15px;
        }

        .product-price {
            font-size: 18px;
            font-weight: 700;
            color: var(--samsung-dark);
            margin-bottom: 15px;
        }

        .product-price span {
            font-size: 12px;
            color: #777;
            font-weight: normal;
        }

        /* Bento Grid Ecosystem */
        .bento-section {
            background: var(--samsung-gray);
            padding: 80px 0;
        }

        .bento-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 40px;
        }

        .bento-card {
            background: white;
            border-radius: 20px;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 320px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        }

        .bento-card.wide {
            grid-column: span 2;
            background: linear-gradient(135deg, #1428a0 0%, #081048 100%);
            color: white;
        }

        .bento-card h3 {
            font-size: 24px;
            margin-bottom: 10px;
        }

        .bento-card p {
            font-size: 14px;
            opacity: 0.8;
            margin-bottom: 20px;
        }

        /* Cart Sidebar Drawer */
        .cart-drawer {
            position: fixed;
            top: 0;
            right: -400px;
            width: 380px;
            height: 100%;
            background: white;
            box-shadow: -5px 0 25px rgba(0,0,0,0.1);
            z-index: 2000;
            transition: right 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .cart-drawer.open {
            right: 0;
        }

        .cart-header {
            padding: 20px;
            border-bottom: 1px solid var(--samsung-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .cart-body {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }

        .cart-footer {
            padding: 20px;
            border-top: 1px solid var(--samsung-border);
            background: #f9f9f9;
        }

        .cart-item {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
            border-bottom: 1px solid #eee;
            padding-bottom: 15px;
            align-items: center;
        }

        .cart-item img {
            width: 60px;
            height: 60px;
            object-fit: contain;
        }

        .cart-item-info h4 {
            font-size: 14px;
            margin-bottom: 5px;
        }

        .cart-item-info p {
            font-size: 13px;
            color: #555;
            font-weight: bold;
        }

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 1500;
            display: none;
        }

        .overlay.active {
            display: block;
        }

        /* Footer */
        footer {
            background: #111;
            color: #aaa;
            padding: 60px 40px 30px;
            font-size: 13px;
        }

        .footer-grid {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
            margin-bottom: 40px;
        }

        .footer-col h4 {
            color: white;
            font-size: 15px;
